<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CBSA Forum</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="navbar">
    <div class="nav-container">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        Cox's Bazar Student Association
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle">
      <label for="nav-toggle" class="nav-burger" aria-label="Menu">
        <span></span><span></span><span></span>
      </label>

      <nav>
        <a href="/">Home</a>
        <% if (user) { %>
          <a href="/dashboard">Dashboard</a>
          <a href="/post/new">New Post</a>
          <a href="/profile">Profile</a>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="admin-link">Admin Panel</a>
          <% } %>
          <span class="who">Hi, <%= user.name %> <em>(<%= user.role %>)</em></span>
          <form action="/logout" method="POST" class="inline-form">
            <button type="submit" class="link-btn">Logout</button>
          </form>
        <% } else { %>
          <a href="/login">Login</a>
          <a href="/register" class="admin-link">Register</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="container">
    <%- body %>
  </main>

  <footer class="site-footer">
    <p>&copy; <%= new Date().getFullYear() %> Cox's Bazar Student Association Forum</p>
  </footer>
</body>
</html>

