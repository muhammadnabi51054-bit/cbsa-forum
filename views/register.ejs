<div class="card" style="max-width:480px;margin:0 auto;">
  <h2>Join the CBSA Forum</h2>
  <% if (error) { %><div class="error-box"><%= error %></div><% } %>
  <form class="stack" method="POST" action="/register">
    <div>
      <label>Full Name</label>
      <input type="text" name="name" value="<%= old.name || '' %>" required>
    </div>

<div>
      <label>Email</label>
      <input type="email" name="email" value="<%= old.email || '' %>" required>
    </div>
    <div>
      <label>Batch / Year (optional)</label>
      <input type="text" name="batch" value="<%= old.batch || '' %>" placeholder="e.g. 2022">
    </div>

<div>
      <label>Password</label>
      <input type="password" name="password" required>
    </div>
    <div>
      <label>Confirm Password</label>
      <input type="password" name="confirm_password" required>
    </div>
    <button type="submit">Create Account</button>
  </form>
  <p style="margin-top:14px;font-size:0.9rem;">Already have an account? <a href="/login">Login</a></p>
</div>
